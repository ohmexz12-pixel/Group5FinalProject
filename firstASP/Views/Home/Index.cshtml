
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container py-5">
        <div class="row align-items-center">

            <div class="col-lg-7 py-4">

                <p class="hero-tag">
                    <i class="bi bi-basketball"></i>
                    BASKETBALL RESERVATION SYSTEM
                </p>

                <h1 class="hero-title">
                    Your Court.<br />
                    Your Game.
                </h1>

                <p class="hero-description">
                    Welcome to BRS, a simple and convenient way to
                    reserve and manage your school's basketball court.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">

                    @if (User.IsInRole("Student"))
                    {
                        <a asp-controller="Reservations"
                           asp-action="Create"
                           class="btn btn-book">
                            Reserve a Court
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Reservations"
                           asp-action="Admin"
                           class="btn btn-book">
                            Manage Reservations
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }

                    <a asp-controller="Courts"
                       asp-action="Index"
                       class="btn btn-outline-light mt-3">
                        View Schedule
                    </a>

                </div>

            </div>

            <div class="col-lg-5 text-center py-4">
                <div class="basketball-icon">
                    <i class="bi bi-basketball"></i>
                </div>

                <h3 class="text-white fw-bold mt-4">
                    It's Game Time.
                </h3>

                <p class="text-white-50">
                    Plan your next game with BRS.
                </p>
            </div>

        </div>
    </div>
</section>

<section class="container py-5">

    <div class="text-center mb-5">
        <p class="section-label">WHAT YOU CAN DO</p>

        <h2 class="fw-bold">Everything in One Place.</h2>

        <p class="text-muted">
            Manage your court reservations with ease.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <a asp-controller="Reservations"
               asp-action="Create"
               class="text-decoration-none text-dark">

                <div class="feature-card h-100">
                    <i class="bi bi-calendar-plus feature-icon"></i>

                    <h5>Reserve a Court</h5>

                    <p>
                        Submit a reservation request for your preferred date and time.
                    </p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Courts"
               asp-action="Index"
               class="text-decoration-none text-dark">

                <div class="feature-card h-100">
                    <i class="bi bi-calendar-week feature-icon"></i>

                    <h5>Check Schedule</h5>

                    <p>
                        View approved reservations and check court availability.
                    </p>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Guidelines"
               asp-action="Index"
               class="text-decoration-none text-dark">

                <div class="feature-card h-100">
                    <i class="bi bi-journal-text feature-icon"></i>

                    <h5>Court Guidelines</h5>

                    <p>
                        Read the rules and reminders before using the court.
                    </p>
                </div>
            </a>
        </div>

    </div>

</section>

<section class="container pb-5">
    <div class="booking-banner text-center">
        <h2 class="fw-bold">Play Fair. Play Together.</h2>

        <p class="mb-0">
            BRS makes basketball court reservations easier and more organized.
        </p>
    </div>
</section>
